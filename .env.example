# ==============================================================================
# ZeroCut Stream (公開台帳・抽選プロトコルリポジトリ) — 環境変数テンプレート
# コピー手順: cp .env.example .env && cp .env.example web/.env
# ※公開定数（地域別時給表・固定作業分数）は環境変数ではなく docs/public_constants.json で管理します。
# ※動画生成エンジンは別リポジトリ (zerocut-engine: 非公開) に分離されています。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8.0 データベース設定 (Docker Compose & Prisma 共通)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=zerocut_root_dev_password
MYSQL_DATABASE=zerocut_stream
MYSQL_USER=zerocut_app
MYSQL_PASSWORD=zerocut_dev_password
MYSQL_PORT=3306

DATABASE_URL="mysql://zerocut_app:zerocut_dev_password@127.0.0.1:3306/zerocut_stream"

# ------------------------------------------------------------------------------
# 2. サーバーサイド・ランタイム運営主体設定 (ビルド時焼き込み NEXT_PUBLIC_* 不使用)
# 同一 Docker イメージを再ビルドせずに生身配信者・スタジオ・AIチャンネルの誰もがセルフホストできるよう
# サーバー実行時に読み込みます。
# ------------------------------------------------------------------------------
APP_LOCALE=ja
LOG_LEVEL=info
OPERATOR_NAME="ZeroCut Commons Reference Node"
CHANNEL_NAME="ZeroCut Stream (#1)"
YOUTUBE_CHANNEL_URL="https://www.youtube.com/@zerocut-stream-example"

# ------------------------------------------------------------------------------
# 3. 暗号化・本人認証セキュリティ鍵 (本番運用時は必ず openssl rand -hex 32 等で生成)
# ------------------------------------------------------------------------------
# Steamアクティベーションキーの AES-256-GCM 暗号化鍵 (厳密に64文字の16進文字列 = 32バイト)
STEAM_KEY_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 🚨【重要・ローテーション不可】
# OAuth認証識別子 ("${provider}:${accountId}") を HMAC-SHA256 ハッシュ化して ViewerUser を一意特定するための秘密鍵です。
# 一度本番運用を開始した後にこの値を変更すると、既存全ユーザーの同一性マッピングが失われ別アカウント扱いとなるため、
# 絶対にローテーション（変更）しないでください。
AUTH_IDENTITY_PEPPER="dev-only-non-rotatable-identity-pepper-replace-before-prod"

# Auth.js (NextAuth v5: 5.0.0-beta.32) セッション署名鍵 & Google OAuth 設定 (Milestone 3 で使用)
AUTH_SECRET="dev-only-auth-secret-replace-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# ローカル開発・E2E検証用ログインの有効化フラグ (NODE_ENV=production 時はコード側で強制無効化)
ENABLE_DEV_AUTH="false"

# ------------------------------------------------------------------------------
# 4. League of Entropy drand 公開乱数ビーコン & YouTube 公開データ読取設定
# ------------------------------------------------------------------------------
DRAND_API_BASE_URL="https://api.drand.sh"
DRAND_CHAIN_HASH="52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971"
DRAND_GENESIS_UNIX_SEC="1692803367"
DRAND_PERIOD_SEC="3"

# YouTube Data API v3 読取専用キー (Milestone 3 の公開再生数スナップショット取得 videos.list で使用)
YOUTUBE_DATA_API_KEY=""
